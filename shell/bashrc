# Interactive bash. Works on macOS and Linux: each block only runs if its tool is installed.

# Homebrew (Apple Silicon or Intel)
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [ -x "$brew" ] && eval "$("$brew" shellenv bash)" && break
done

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# History: large, no duplicates, written after every command so tabs share it
HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# Completion
if [ -r "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]; then
  . "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
elif [ -r /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
fi
# Apple's git does not register its completion anywhere bash-completion looks
git_completion=/Library/Developer/CommandLineTools/usr/share/git-core/git-completion.bash
[ -r "$git_completion" ] && . "$git_completion"
unset git_completion

# fzf: Ctrl+R searches history, Ctrl+T finds files, Alt+C jumps to a folder
command -v fzf >/dev/null && eval "$(fzf --bash)"

# Machine-specific settings and secrets, never committed
[ -r "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"

# Piplup prompt, implemented directly in Bash.
if [[ $- == *i* ]]; then
  PROMPT_DIRTRIM=3
  _piplup_prompt() {
    local last_status=$? branch='' arrow='\[\e[1;38;2;141;213;199m\]' who='\u'
    # Over SSH, show the host too so remote shells stand out.
    [[ -n $SSH_CONNECTION ]] && who='\u@\h'
    if command -v git >/dev/null; then
      branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) ||
        branch=$(git rev-parse --short HEAD 2>/dev/null) || branch=''
    fi
    # Expand branch data only when Bash displays PS1, so it stays literal.
    PIPLUP_BRANCH=$branch
    PS1='\n\[\e[38;2;32;75;117m\]\[\e[48;2;32;75;117;38;2;244;247;232m\]🐧 '"$who"' '
    PS1+='\[\e[48;2;244;207;100;38;2;32;75;117m\]\[\e[38;2;20;43;69m\] \w '
    if [[ -n $branch ]]; then
      PS1+='\[\e[48;2;116;185;220;38;2;244;207;100m\]\[\e[38;2;20;43;69m\]  ${PIPLUP_BRANCH} '
      PS1+='\[\e[48;2;20;43;69;38;2;116;185;220m\]'
    else
      PS1+='\[\e[48;2;20;43;69;38;2;244;207;100m\]'
    fi
    PS1+='\[\e[38;2;244;247;232m\]  \A \[\e[0;38;2;20;43;69m\]\[\e[0m\]\n'
    [[ $last_status == 0 ]] || arrow='\[\e[1;38;2;239;128;128m\]'
    PS1+="${arrow}"'\[\e[0m\] '
  }
  # Keep existing hooks and capture the command status before history updates.
  PROMPT_COMMAND="_piplup_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi
